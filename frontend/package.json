{
  "name": "devknowledge",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "ng serve --host 127.0.0.1",
    "build": "ng build",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "lint": "eslint src --max-warnings 0",
    "test": "vitest run",
    "e2e": "playwright test",
    "format:check": "prettier --check \"src/**/*.{ts,html,css}\" \"e2e/*.ts\" \"*.ts\" \"*.mjs\" \"package.json\" \"angular.json\" \"tsconfig*.json\""
  },
  "dependencies": {
    "@angular/common": "22.2.6",
    "@angular/compiler": "22.2.6",
    "@angular/core": "22.2.6",
    "@angular/forms": "22.2.6",
    "@angular/platform-browser": "22.2.6",
    "@angular/router": "22.2.6",
    "angular-oauth2-oidc": "22.0.2",
    "dompurify": "3.4.18",
    "highlight.js": "11.11.1",
    "marked": "18.2.1",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.7",
    "@angular/cli": "22.2.7",
    "@angular/compiler-cli": "22.2.6",
    "@playwright/test": "1.65.1",
    "@types/node": "24.10.1",
    "eslint": "10.15.0",
    "jsdom": "31.0.1",
    "prettier": "3.6.2",
    "typescript": "6.0.2",
    "typescript-eslint": "8.73.0",
    "vitest": "4.1.12",
    "yaml": "2.9.1"
  },
  "overrides": {
    "vite": "8.3.8",
    "picomatch": "4.0.7"
  },
  "type": "module"
}
