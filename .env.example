# Local development only. No cloud credentials are required.
ASPNETCORE_ENVIRONMENT=Development
Auth__Development=true
Auth__AdminSubject=local|admin
Storage__Local=true
Storage__Seed=true
# Production requires Auth__Development=false, Storage__Local=false,
# Auth__Issuer, Auth__Audience, Auth__AdminSubject, Cosmos__Endpoint,
# Cosmos__Database, and Frontend__Origin. Never place secrets in Git.
